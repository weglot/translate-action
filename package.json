{
  "name": "translate-action",
  "version": "0.1.0",
  "description": "GitHub Action to translate localization files with Weglot",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "rm -rf lib dist && tsc && rollup -c rollup.config.mjs",
